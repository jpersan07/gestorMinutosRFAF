{
  // Dominio puro: sin tipos DOM ni Node. Si el motor usa window, localStorage,
  // IndexedDB, etc., la compilación falla.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.domain.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/domain"],
  "exclude": ["src/**/*.test.ts", "src/**/__tests__"]
}
